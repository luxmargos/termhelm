{
  "name": "@luxmargos/termhelm",
  "version": "0.2.1",
  "description": "Launch and manage commands in native desktop terminal windows on macOS, Windows, and Linux.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "bin": {
    "termhelm": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "native/windows",
    "scripts/verify-windows-helpers.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.public-api.json",
    "verify:windows-helpers": "node scripts/verify-windows-helpers.mjs",
    "prepack": "pnpm run build && pnpm run verify:windows-helpers"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
